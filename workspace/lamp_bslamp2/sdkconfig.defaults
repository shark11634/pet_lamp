# ==================================================================
# 宠物活动状态灯 V1 — 灯端 sdkconfig 默认值（ESP-IDF v5.x）
#
# 关键点（需求 5.7 节「bslamp2 构建注意事项」）：
#   bslamp2 内部 ESP32 有特殊兼容要求 —— 必须使用**单核**构建。
#   ESPHome/ESP-IDF 侧对应 CONFIG_FREERTOS_UNICORE=y；
#   此外社区项目还需要 ignore_efuse_custom_mac / ignore_efuse_mac_crc，
#   那是 ESPHome 的运行时开关，在纯 ESP-IDF 工程中通过下面的
#   MAC 来源设置等效处理（不信任 eFuse 中的自定义 MAC）。
# ==================================================================

# ---- 目标芯片与 Flash --------------------------------------------
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_BAUD_115200B=y
CONFIG_ESPTOOLPY_MONITOR_BAUD_115200B=y

# ---- 单核（bslamp2 必须） ----------------------------------------
CONFIG_FREERTOS_UNICORE=y
CONFIG_FREERTOS_HZ=1000

# ---- 精简：灯端无网络、无手机、无 HomeAssistant -------------------
# 不启用 Wi-Fi（2.1 节最终运行原则）
CONFIG_ESP_WIFI_ENABLED=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# ---- 蓝牙：NimBLE + Observer（只做被动扫描） ----------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
# 作为 Observer 接收广播
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
# 扫描缓存与主机任务
CONFIG_BT_NIMBLE_USE_ESP_TIMER=y
CONFIG_BT_NIMBLE_TASK_STACK_SIZE=4096
CONFIG_BT_NIMBLE_MSYS1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# ---- 日志 ---------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_COLORS=n

# ---- 任务栈 -------------------------------------------------------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# ---- 电源与稳定性 -------------------------------------------------
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_BROWNOUT_DET=y

# ---- 分区表：默认单 app 分区足够 V1 -------------------------------
CONFIG_PARTITION_TABLE_SINGLE_APP=y
