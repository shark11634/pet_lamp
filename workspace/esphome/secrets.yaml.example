# ==================================================================
# secrets.yaml — 复制为 secrets.yaml 并填入你自己的值
#
# ⚠️ secrets.yaml 不要提交到公开仓库。
# ==================================================================

# ---- Wi-Fi ----
wifi_ssid: "你的WiFi名称"
wifi_password: "你的WiFi密码"

# 断网时的兜底热点（需求 §2.1：核心功能不依赖网络，这只是方便你重新配网）
ap_password: "至少8位的热点密码"

# ---- ESPHome API 加密密钥 ----
# 生成方式：  openssl rand -base64 32
api_key: "REPLACE_WITH_32_BYTES_BASE64"

# ---- OTA 密码 ----
ota_password: "你的OTA密码"

# ---- 宠物状态灯内置网页的 Basic Auth 密码 ----
# 同 WiFi 下任何人只要知道地址就能打开网页，**务必改掉默认值**
pet_web_password: "改成一个只有你知道的密码"

# ---- MQTT（可选，档 2） ----
# mqtt_broker: "192.168.1.10"
# mqtt_user: "mqtt"
# mqtt_password: "mqtt密码"
