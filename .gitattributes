# ==================================================================
# 编码与换行约定
#
# 为什么需要这个文件：本项目踩过编码的三个坑
#   1. 中文源文件被 PowerShell 的 Set-Content 改写成乱码
#   2. .ps1 文件缺 UTF-8 BOM 导致中文注释解析失败
#   3. 写入时插入字面量 `n（反引号+n）而不是换行符
# 固定住约定，避免不同机器/工具链把文件改坏。
# ==================================================================

# 全局默认：统一 LF。混用 CRLF/LF 会让行数统计和 diff 变得不可靠。
* text=auto eol=lf

# ------------------------------------------------------------------
# 二进制：绝不要做换行转换
# ------------------------------------------------------------------
*.bin binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.gz binary
*.bz2 binary
*.7z binary
*.tar binary
*.exe binary
*.o   binary
*.obj binary
*.a   binary
*.elf binary
*.uf2 binary
*.hex binary

# ------------------------------------------------------------------
# ★ PowerShell 脚本必须保留 CRLF 并带 BOM
# ------------------------------------------------------------------
# 本项目在 Windows PowerShell 5.1 上运行这些脚本：
#   · 缺 UTF-8 BOM 时，中文注释会导致解析错误
#     （报"字符串缺少终止符"之类）
#   · 文件内已有 BOM，这里声明不转换换行，避免 diff 抖动
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# ------------------------------------------------------------------
# 明确按文本处理且用 LF 的类型
# ------------------------------------------------------------------
*.c    text eol=lf
*.h    text eol=lf
*.cpp  text eol=lf
*.ino  text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# ------------------------------------------------------------------
# diff 体验
# ------------------------------------------------------------------
# 这些文件在 diff 里按二进制看会没意义，但也不想让 git 猜错
*.md   diff=markdown
